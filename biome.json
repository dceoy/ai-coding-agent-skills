{
  "files": {
    "includes": ["**", "!!**/*.yaml", "!!**/*.yml"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useQwikValidLexicalScope": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noExcessiveLinesPerFile": "off",
        "useExportsLast": "off"
      }
    }
  }
}
