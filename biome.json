{
	"files": {
		"includes": [
			"**",
			"!!**/.agents",
			"!!**/.claude",
			"!!**/templates",
			"!!**/*.gs",
			"!!**/*.yaml",
			"!!**/*.yml"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"correctness": {
				"useQwikValidLexicalScope": "off"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"noExcessiveLinesPerFile": "off",
				"useExportsLast": "off",
				"noNonNullAssertion": "off",
				"noDefaultExport": "off"
			},
			"suspicious": {}
		}
	}
}
