{
	"name": "ai-coding-agent-skills",
	"version": "0.0.0",
	"private": true,
	"description": "Agent skills for AI coders",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "oxlint --ignore-pattern 'node_modules/**' .",
		"lint:fix": "oxlint --ignore-pattern 'node_modules/**' --fix .",
		"format": "biome format --write skills tests scripts package.json tsconfig.json",
		"format:check": "biome format skills tests scripts package.json tsconfig.json",
		"test": "pnpm run build && node --test tests/gas-html-artifact.test.mjs",
		"all": "pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm run test",
		"build": "tsc --project tsconfig.json && biome format --write skills/gas-html-artifact/scripts/deploy.mjs tests/gas-html-artifact.test.mjs",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dceoy/ai-coding-agent-skills.git"
	},
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@google/clasp": "3.4.1",
		"@types/node": "26.6.4",
		"oxlint": "^1.86.0",
		"typescript": "7.0.2"
	}
}
