{
	"name": "ai-coding-agent-skills",
	"version": "0.0.0",
	"private": true,
	"description": "Agent skills for AI coders",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"lint": "oxlint --ignore-pattern 'node_modules/**' .",
		"lint:fix": "oxlint --ignore-pattern 'node_modules/**' --fix .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "node --test",
		"all": "pnpm run format && pnpm run lint:fix && pnpm run test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dceoy/ai-coding-agent-skills.git"
	},
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@google/clasp": "3.4.1",
		"oxlint": "^1.86.0"
	}
}
